  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kestro Time Registration Services",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/python",
      "module": "kestro_timeregistration",
      "console": "integratedTerminal"
